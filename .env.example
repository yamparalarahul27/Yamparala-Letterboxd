# Copy to .env.local and fill in. Real values live in Vercel project settings.

# Public — safe to ship in the client bundle (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by sync scripts (scripts/*.mjs) and any server-side code.
# Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
